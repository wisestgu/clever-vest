# Dollo backend configuration. Every provider runs in sandbox mode when its keys are empty.
PORT=4000
DB_FILE=backend/data/db.json

# Indicative USD→NGN rate used by the sandbox FX provider (₦ per $1) and the withdrawal fee.
FX_USD_NGN=1520
WITHDRAWAL_FEE_PCT=1
WITHDRAWAL_FEE_MIN_USD=0.5

# Alpaca paper trading (optional). When set, orders route to the Alpaca paper API and quotes come from Alpaca market data.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Financial Modeling Prep (optional). When set, the insider feed uses live filings.
FMP_API_KEY=

# Cleva (optional). The adapter is a sandbox simulation until production credentials and API docs are provided.
CLEVA_API_KEY=
